<Project Sdk="Microsoft.NET.Sdk">
  <!-- Backend=<checkout>/backend compiles the probe against another checkout, e.g. main, for the before/after. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Backend Condition="'$(Backend)' == ''">../../../backend</Backend>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(Backend)/AgentHub.Api.csproj" />
  </ItemGroup>
</Project>
