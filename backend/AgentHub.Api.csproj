<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentHub.Api</RootNamespace>
    <!-- The image build passes -p:InformationalVersion=<tag>; anything else (dotnet run, the
         test host) would otherwise report the SDK default "1.0.0" and look like a release. -->
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Enterprise Edition sources (source-available under ee/LICENSE, not AGPL). -->
  <ItemGroup>
    <Compile Include="../ee/backend/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Offizieller Kubernetes-Client -->
    <PackageReference Include="NCrontab" Version="3.4.0" />
    <PackageReference Include="KubernetesClient" Version="17.0.14" />
    <!-- OIDC / JWT (Keycloak) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- Persistenz -->
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <!-- S3-compatible object storage (presigned URLs, transcript) -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.405.1" />
    <!-- Remote MCP endpoint (Streamable HTTP) and the OAuth 2.1 server that guards it.
         The OpenIddict store is in-memory: only dynamically registered clients need to
         outlive a restart, and those are persisted in Postgres (McpClientStore). The
         interactive OIDC handler drives the browser login for /connect/authorize; the
         API itself stays on JwtBearer. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.0.0-preview.2" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.5.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.5.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" />
    <!-- Keep the XML signature implementation patched while the authentication parent's
         transitive minimum lags behind. Removing this pin restores vulnerable resolution. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" NoWarn="NU1510" />
  </ItemGroup>

</Project>
