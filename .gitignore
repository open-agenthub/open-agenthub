# Build artifacts
**/bin/
**/obj/
backend/bin/
backend/obj/
frontend/node_modules
frontend/dist/
agent-runtime/session-agent/node_modules
mcp/agenthub/node_modules

# Local environment-specific deployment values (registries, hosts, secrets)
deploy/
*.local.yaml

# Agent worktrees / local Claude state
.claude/

# Local agent tooling state
.superpowers/

# Core dumps (kernel.core_pattern "core" or "core.<pid>"). A backend or pwsh aborted in a
# checkout leaves several hundred MB here, and `git add -A` has nearly committed them twice
# (#367, #377); GitHub then rejects the whole push. Directories named core stay trackable.
core
core.[0-9]*
!core/
